{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Processforge Flowsheet Configuration Schema",
  "type": "object",
  "required": [
    "providers",
    "streams",
    "units",
    "simulation"
  ],
  "properties": {
    "providers": {
      "type": "object",
      "description": "Named provider declarations (Terraform-inspired). At least one provider must be specified.",
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z0-9_]+$": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["coolprop", "cantera", "modelica", "openmc", "festim", "idaes"],
              "description": "Provider engine type"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Endpoint URL for containerized providers (openmc, festim). Omit for pip-installable providers (coolprop, cantera, modelica)."
            },
            "mechanism": {
              "type": "string",
              "description": "Cantera mechanism file path (e.g. 'gri30.yaml')"
            },
            "phase": {
              "type": "string",
              "description": "Cantera phase name within the mechanism file"
            },
            "output_dir": {
              "type": "string",
              "description": "Provider output directory (Modelica/OpenMC)"
            },
            "cross_sections": {
              "type": "string",
              "description": "OpenMC provider: path to cross_sections.xml. Overrides OPENMC_CROSS_SECTIONS env var."
            },
            "docker_image": {
              "type": "string",
              "description": "Docker image for containerized providers (openmc, festim). Overrides the catalog default when set."
            }
          },
          "additionalProperties": true
        }
      }
    },
    "default_provider": {
      "type": "string",
      "description": "Name of the provider used by units that omit a 'provider' key. Defaults to built-in CoolProp."
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "materials": {
      "type": "object",
      "description": "Named material definitions. Keys are component names referenced in stream z-fractions or used as structural materials.",
      "patternProperties": {
        "^[a-zA-Z0-9_]+$": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "integer",
              "description": "Unique numeric ID referenced by units to indicate what material they are made of"
            },
            "density": {
              "type": "number",
              "exclusiveMinimum": 0.0
            },
            "density_units": {
              "type": "string",
              "enum": ["g/cm3", "g/cc", "kg/m3", "atom/b-cm", "atom/cm3", "sum", "macro"]
            },
            "temperature": {
              "type": "number",
              "minimum": 0.0,
              "description": "Temperature in Kelvin"
            },
            "depletable": {
              "type": "boolean",
              "default": false
            },
            "nuclides": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "percent", "percent_type"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Element symbol (e.g. 'C', 'Fe') or nuclide identifier (e.g. 'U235')"
                  },
                  "percent": {
                    "type": "number",
                    "exclusiveMinimum": 0.0
                  },
                  "percent_type": {
                    "type": "string",
                    "enum": ["ao", "wo"]
                  }
                },
                "additionalProperties": false
              }
            },
            "elements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["element", "percent", "percent_type"],
                "properties": {
                  "element": {
                    "type": "string",
                    "description": "Periodic table symbol, e.g. 'C', 'Fe', 'Ni'"
                  },
                  "percent": {
                    "type": "number",
                    "exclusiveMinimum": 0.0
                  },
                  "percent_type": {
                    "type": "string",
                    "enum": ["ao", "wo"]
                  }
                },
                "additionalProperties": false
              },
              "description": "Element-fraction entries for openmc.Material.add_element() calls"
            },
            "extra": {
              "type": "object",
              "description": "Provider-specific material properties (e.g. FESTIM diffusion coefficients: D_0, E_D)"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "material_mixes": {
      "type": "object",
      "description": "Named mixture definitions composed of materials from the materials section.",
      "patternProperties": {
        "^[a-zA-Z0-9_]+$": {
          "type": "object",
          "required": ["id", "components"],
          "properties": {
            "id": {
              "type": "integer",
              "description": "Unique numeric ID for this material mix"
            },
            "percent_type": {
              "type": "string",
              "enum": ["ao", "wo", "vo"],
              "description": "Fraction type for OpenMC mix_materials: atom, weight, or volume fractions"
            },
            "components": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Key from the materials section"
                  },
                  "fraction": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "maximum": 1.0
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "streams": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_]+$": {
          "type": "object",
          "required": [
            "P",
            "T",
            "flowrate"
          ],
          "properties": {
            "P": {
              "type": "number",
              "minimum": 100.0
            },
            "T": {
              "type": "number",
              "minimum": 0.0
            },
            "flowrate": {
              "type": "number",
              "minimum": 0.0
            },
            "z": {
              "type": "object"
            },
            "material_mix": {
              "type": "integer",
              "description": "id of the material mix carried by this stream"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "units": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_]+$": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Pump",
                "Valve",
                "Strainer",
                "Tank",
                "Pipes",
                "Flash",
                "Heater",
                "CSTR",
                "PFR",
                "IdealGasReactor",
                "SolverUnit"
              ]
            },
            "provider": {
              "type": "string",
              "description": "Name of a declared provider to use for this unit. Omit to use the flowsheet default (CoolProp)."
            },
            "in": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Single inlet stream name"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "description": "Multiple inlet stream names"
                }
              ]
            },
            "out": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Single outlet stream name"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "description": "Multiple outlet stream names (unit broadcasts output to each)"
                }
              ]
            },
            "delta_p": {
              "type": "number"
            },
            "efficiency": {
              "type": "number"
            },
            "pressure_ratio": {
              "type": "number",
              "description": "Legacy valve pressure ratio (P_out = ratio * P_in). Ignored in hydraulic mode with a warning."
            },
            "Cv": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "description": "IDAES-style valve flow coefficient [mol/s/Pa**0.5]. Used by hydraulic network mode."
            },
            "valve_opening": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0,
              "description": "Valve opening fraction [0, 1] (hydraulic mode). Defaults to 1 (fully open)."
            },
            "valve_function": {
              "type": "string",
              "enum": ["linear", "quick_opening", "equal_percentage"],
              "description": "IDAES valve characteristic (hydraulic mode). Default 'linear'."
            },
            "alpha": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "description": "Equal-percentage valve rangeability (hydraulic mode). Default 100."
            },
            "check_valve": {
              "type": "boolean",
              "default": false,
              "description": "If true the valve only permits forward flow (hydraulic mode)."
            },
            "pump_curve": {
              "type": "object",
              "description": "EPANET/WNTR-style head-flow curve for pumps (hydraulic mode). dP = A - B*Q**C.",
              "properties": {
                "flow": {
                  "type": "array",
                  "items": { "type": "number", "minimum": 0.0 },
                  "minItems": 1
                },
                "head": {
                  "type": "array",
                  "items": { "type": "number", "minimum": 0.0 },
                  "description": "Head [m] at each flow point. Converted using the fluid density."
                },
                "delta_p": {
                  "type": "array",
                  "items": { "type": "number", "minimum": 0.0 },
                  "description": "Pressure rise [Pa] at each flow point."
                }
              },
              "required": ["flow"],
              "additionalProperties": false
            },
            "design_flowrate": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "description": "Design molar flow [mol/s] at which delta_p is specified (hydraulic mode for pipes/strainers)."
            },
            "flow_boundary": {
              "type": "number",
              "minimum": 0.0,
              "description": "Fixed molar flow [mol/s] for a feed stream in hydraulic mode (optional pressure-flow boundary)."
            },
            "delta_p": {
              "type": "number"
            },
            "diameter": {
              "type": "number"
            },
            "length": {
              "type": "number",
              "description": "Pipe length [m] (hydraulic mode geometry path)."
            },
            "roughness": {
              "type": "number",
              "minimum": 0.0,
              "description": "Absolute pipe roughness [m] (hydraulic mode geometry path). Default 0 (smooth)."
            },
            "viscosity": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "description": "Dynamic viscosity [Pa·s] override (hydraulic mode). Defaults to the provider value."
            },
            "molar_volume": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "description": "Molar volume [m³/mol] override (hydraulic mode). Defaults to the provider value."
            },
            "density": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "description": "Density [kg/m³] override (hydraulic mode). Defaults to the provider value."
            },
            "molar_mass": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "description": "Molar mass [kg/mol] override (hydraulic mode). Defaults to the provider value."
            },
            "cp": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "description": "Molar heat capacity [J/mol/K] override. Defaults to the provider value."
            },
            "volume": {
              "type": "number"
            },
            "initial_level": {
              "type": "number"
            },
            "material": {
              "type": "integer",
              "description": "id of the material this unit is made of"
            }
          },
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": { "type": { "const": "SolverUnit" } }
              },
              "then": {
                "required": ["sim_type"],
                "properties": {
                  "sim_type": {
                    "type": "string",
                    "description": "Provider-interpreted simulation mode (e.g. 'heat_2d', 'eigenvalue')"
                  },
                  "solver_config": {
                    "type": "object",
                    "description": "Provider-specific settings — opaque to the framework (mesh, BCs, traps, exports, …)"
                  }
                }
              }
            },
            {
              "if": {
              "not": {
                "properties": {
                  "type": { "enum": ["SolverUnit"] }
                }
              }
              },
              "then": {
                "required": ["in", "out"]
              }
            }
          ]
        }
      }
    },
    "simulation": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "steady",
            "dynamic"
          ]
        },
        "backend": {
          "type": "string",
          "enum": [
            "pyomo",
            "casadi",
            "scipy"
          ],
          "description": "EO solver backend for steady-state mode. Overrides default_backend."
        },
        "default_backend": {
          "type": "string",
          "enum": [
            "pyomo",
            "casadi",
            "scipy"
          ],
          "default": "scipy",
          "description": "EO solver backend used when 'backend' is omitted. Defaults to 'scipy'."
        },
        "t0": {
          "type": "number",
          "description": "Start time for dynamic simulation"
        },
        "tf": {
          "type": "number",
          "description": "End time for dynamic simulation"
        },
        "dt": {
          "type": "number",
          "description": "Time step for dynamic simulation"
        },
        "convergence_signal": {
          "type": "object",
          "description": "Provider-specific convergence signal for homotopy fallback. Defaults to k_eff for OpenMC.",
          "properties": {
            "signal_key": {
              "type": "string",
              "description": "Scalar key to monitor for convergence (e.g. 'k_eff', 'flux', 'temperature')"
            },
            "target": {
              "type": "number",
              "description": "Target value to approach (e.g. 1.0 for k_eff)"
            },
            "tolerance": {
              "type": "number",
              "default": 0.01,
              "description": "Acceptance tolerance relative to target"
            },
            "provider": {
              "type": "string",
              "description": "Provider (declared in the 'providers' block) to apply this signal to. If omitted, applies to all providers. Validated against declared provider names at flowsheet validation time."
            }
          },
          "required": ["signal_key", "target"]
        },
        "hydraulics": {
          "type": "object",
          "description": "Pressure-driven hydraulic network mode. When enabled, stream pressures and element flows are solved simultaneously each timestep with a native SciPy network solver instead of being imposed by each unit. Valves, pumps, pipes and strainers use physically consistent pressure-flow laws; tank outflow is network-determined.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Opt-in to hydraulic network mode."
            },
            "tol": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "default": 1e-8,
              "description": "Scaled residual tolerance for the network solve."
            },
            "max_iter": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 50,
              "description": "Maximum solver evaluations (per active-set round)."
            },
            "flow_scale": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "default": 1e-3,
              "description": "Flow scaling [mol/s] used by the network solver."
            },
            "pressure_scale": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "default": 1e5,
              "description": "Pressure scaling [Pa] used by the network solver."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
