FROM mambaorg/micromamba:1.5.8

USER root
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libgomp1 && \
    rm -rf /var/lib/apt/lists/*
USER $MAMBA_USER

RUN micromamba install -y -n base -c conda-forge 'python>=3.12' && \
    micromamba clean --all --yes

WORKDIR /app
RUN micromamba run -n base pip install geant4-pybind processforge

COPY geant4_entrypoint.sh .
USER root
RUN chmod +x /app/geant4_entrypoint.sh

ENV PROVIDER_TYPE=geant4
ENV PROCESSFORGE_OUTPUT_DIR=/tmp/processforge
ENV PORT=9003
VOLUME /data

EXPOSE 9003
ENTRYPOINT ["/app/geant4_entrypoint.sh"]
CMD ["micromamba", "run", "-n", "base", "python", "-m", "processforge.api.serve"]