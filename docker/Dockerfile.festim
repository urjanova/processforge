FROM mambaorg/micromamba:1.5.8

USER root
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*
USER $MAMBA_USER

# FESTIM + FEniCSx are only available on conda-forge
RUN micromamba install -y -n base -c conda-forge festim fenics-dolfinx && \
    micromamba clean --all --yes

WORKDIR /app
RUN micromamba run -n base pip install "processforge[api]"

ENV PROVIDER_TYPE=festim
# Run artifacts are simulation-specific and ephemeral; write them to a
# world-writable container-local dir rather than the /data volume.
ENV PROCESSFORGE_OUTPUT_DIR=/tmp/processforge
ENV PORT=9002
VOLUME /data

EXPOSE 9002
CMD ["micromamba", "run", "-n", "base", "python", "-m", "processforge.api.serve"]
