# Local dev image: installs processforge from the local working tree
# (build context must be the repo root) so un-published source changes —
# e.g. the geant4 / shielding_attenuation strategy — are picked up without
# a PyPI release. NOT for production use.
#
#   docker build -f docker/Dockerfile.geant4.local -t processforge-geant4:local .
#   docker run -p 9003:9003 -v "$PWD/outputs:/data" processforge-geant4:local

FROM mambaorg/micromamba:1.5.8

USER root
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl && \
    rm -rf /var/lib/apt/lists/*
USER $MAMBA_USER

# Install Geant4 and processforge from local source
RUN micromamba install -y -n base -c conda-forge 'python>=3.12' && \
    micromamba clean --all --yes

WORKDIR /src
COPY . /src
USER root
RUN chown -R "$MAMBA_USER" /src
USER $MAMBA_USER
RUN micromamba run -n base pip install -e "."

COPY docker/fetch_geant4_data.sh /app/fetch_geant4_data.sh
USER root
RUN chmod +x /app/fetch_geant4_data.sh

ENV PROVIDER_TYPE=geant4
ENV PROCESSFORGE_OUTPUT_DIR=/tmp/processforge
ENV PORT=9003
VOLUME /data

EXPOSE 9003
ENTRYPOINT ["/app/fetch_geant4_data.sh"]
CMD ["micromamba", "run", "-n", "base", "python", "-m", "processforge.api.serve"]