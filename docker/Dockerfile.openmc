FROM mambaorg/micromamba:1.5.8

USER root
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl && \
    rm -rf /var/lib/apt/lists/*
USER $MAMBA_USER

# OpenMC is only available on conda-forge
RUN micromamba install -y -n base -c conda-forge openmc && \
    micromamba clean --all --yes

WORKDIR /app
RUN micromamba run -n base pip install "processforge[api]"

COPY fetch_openmc_data.sh .
USER root
RUN chmod +x /app/fetch_openmc_data.sh
USER $MAMBA_USER

ENV PROVIDER_TYPE=openmc
ENV OPENMC_DATA_ROOT=/data
# Run artifacts are simulation-specific and ephemeral; write them to a
# world-writable container-local dir rather than the (read-only to the
# container user) /data cross-section mount or root-owned /app.
ENV PROCESSFORGE_OUTPUT_DIR=/tmp/processforge
ENV PORT=9001
VOLUME /data

EXPOSE 9001
ENTRYPOINT ["/app/fetch_openmc_data.sh"]
CMD ["micromamba", "run", "-n", "base", "python", "-m", "processforge.api.serve"]
