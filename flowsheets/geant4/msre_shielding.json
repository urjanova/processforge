{
  "metadata": {
    "name": "MSRE Shielding — approximate reactor geometry",
    "description": "Molten Salt Reactor Experiment fixed-source neutron shielding calculation using an approximate cylindrical reactor-core geometry (salt core, graphite reflector, inconel vessel, helium gap, inor structure). Uses all 5 declared materials. 2 MeV isotropic neutron source at reactor centre; scores per-shell energy deposition and transmission.",
    "version": "1.0"
  },
  "providers": {
    "geant4": {
      "type": "geant4",
      "url": "http://localhost:9003",
      "output_dir": "geant4/msre_shielding_run"
    }
  },
